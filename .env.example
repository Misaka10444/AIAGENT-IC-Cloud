# 模型网关配置示例。复制为 .env 后填写，切勿把 .env 提交进仓库。
#
# 默认不需要任何配置：不设置 LLM_MODE 时，系统使用本地确定性引擎，
# 全部功能可用且不发起外部网络请求。

# local（默认）| gateway
LLM_MODE=local

# 网关地址：OpenAI 兼容接口，系统会请求 {LLM_BASE_URL}/chat/completions
# 示例：https://your-gateway.example.com/v1
LLM_BASE_URL=

# 密钥获取方式：向学校统一模型服务平台或指导教师申请。
# 仅通过环境变量注入，禁止写入代码、配置文件或提交进仓库。
LLM_API_KEY=

# 模型标识，由网关提供方给出
LLM_MODEL=

# 超时与采样参数（可选）
LLM_TIMEOUT=20
LLM_TEMPERATURE=0.2
